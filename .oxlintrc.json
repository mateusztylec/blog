{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "nextjs"],
  "jsPlugins": ["./tools/oxlint-plugin/plugin.ts"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [".next/**", "out/**", "next-env.d.ts"],
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-imports": "error",
    "eslint/no-unused-vars": "error",
    "eslint/eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "eslint/no-console": "error",
    "import/no-default-export": "error",
    "oxc/no-barrel-file": [
      "error",
      {
        "threshold": 0
      }
    ],
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase"
      }
    ],
    "blog/naming-convention": "error",
    "blog/no-named-reexport": "error",
    "blog/max-positional-params": "error",
    "nextjs/no-head-element": "off",
    "typescript/no-deprecated": "error",
    "typescript/no-floating-promises": "off",
    "typescript/await-thenable": "off",
    "typescript/unbound-method": "off",
    "typescript/no-base-to-string": "off",
    "typescript/no-redundant-type-constituents": "off",
    "typescript/no-useless-default-assignment": "off",
    "typescript/restrict-template-expressions": "off"
  },
  "overrides": [
    {
      "files": [
        "src/app/**/page.tsx",
        "src/app/**/layout.tsx",
        "src/app/**/not-found.tsx",
        "src/app/robots.ts",
        "src/app/sitemap.ts",
        "**/*.config.ts",
        "**/*.config.mjs",
        "**/*.config.js",
        "tools/oxlint-plugin/plugin.ts"
      ],
      "rules": {
        "import/no-default-export": "off"
      }
    }
  ]
}
